---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const lang = 'en';
---

<BaseLayout title="About Us" lang={lang}>
  <Header lang={lang} />
  
  <main class="page-container">
    <div class="container animate-fade-in">
      <h1 class="page-title">About Us</h1>
      
      <div class="about-grid">
        <div class="about-content">
          <p class="lead">At <strong>JD Pack Solutions</strong> we specialize in packaging, wrapping, and custom logistics solutions.</p>
          
          <p>Strategically located in Miami, Florida, we serve as a vital bridge for companies looking to protect, present, and transport their products with the highest quality standards.</p>
          
          <div class="mission-vision">
            <div class="card">
              <h3>Our Mission</h3>
              <p>To provide innovative and high-quality packaging solutions that add value to our customers' products, ensuring their integrity from production to the final consumer.</p>
            </div>
            
            <div class="card">
              <h3>Our Vision</h3>
              <p>To be recognized as the leading logistics and packaging partner in the market, standing out for our adaptability, technology, and commitment to excellence.</p>
            </div>
          </div>
          
          <h3>Why choose us?</h3>
          <ul class="features-list">
            <li>✓ Personalized attention and technical advice.</li>
            <li>✓ Top quality materials tested under international standards.</li>
            <li>✓ Wide coverage and efficient logistics solutions.</li>
            <li>✓ Commitment to innovation and sustainability.</li>
          </ul>
        </div>
        
        <div class="about-image">
          <div class="image-placeholder" style="background-image: url('/images/products/maquinas-verticales/2-detail.webp');"></div>
        </div>
      </div>
    </div>
  </main>
  
  <Footer lang={lang} />
</BaseLayout>

<style>
  .page-container {
    padding: var(--spacing-xl) 0;
  }
  
  .page-title {
    font-size: 3rem;
    margin-bottom: var(--spacing-lg);
    text-align: center;
    position: relative;
  }
  
  .page-title::after {
    content: '';
    display: block;
    width: 60px;
    height: 4px;
    background-color: var(--color-primary);
    margin: 1rem auto 0;
  }
  
  .about-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--spacing-xl);
    align-items: start;
  }
  
  .lead {
    font-size: 1.25rem;
    color: var(--color-primary);
    font-weight: 500;
    margin-bottom: 1.5rem;
  }
  
  .about-content p {
    margin-bottom: 1.5rem;
    font-size: 1.1rem;
    color: var(--color-gray-800);
  }
  
  .mission-vision {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-md);
    margin: var(--spacing-lg) 0;
  }
  
  .card {
    background: var(--color-gray-100);
    padding: var(--spacing-md);
    border-radius: var(--border-radius);
    border-top: 4px solid var(--color-primary);
  }
  
  .features-list {
    list-style: none;
    margin-top: 1rem;
  }
  
  .features-list li {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
    color: var(--color-gray-800);
  }
  
  .about-image {
    position: sticky;
    top: 100px;
  }
  
  .image-placeholder {
    width: 100%;
    aspect-ratio: 3/4;
    background-color: var(--color-gray-200);
    border-radius: var(--border-radius);
    background-size: cover;
    background-position: center;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  }
  
  @media (max-width: 992px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    
    .about-image {
      position: static;
      order: -1;
      margin-bottom: var(--spacing-lg);
    }
    
    .image-placeholder {
      aspect-ratio: 16/9;
    }
    
    .mission-vision {
      grid-template-columns: 1fr;
    }
  }
</style>
