---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ProductGallery from '../../../components/ProductGallery.astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map(product => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const lang = 'en';

// Assuming we split the markdown body content by *** to separate ES and EN
const bodyContent = product.body ? product.body.split('***') : ['', ''];
const enContent = bodyContent.length > 1 ? bodyContent[1] : (bodyContent[0] || '');
---

<BaseLayout title={product.data.title_en} lang={lang}>
  <Header lang={lang} />
  
  <div class="product-hero" style={`background-image: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url('${product.data.hero_image}')`}>
    <div class="container animate-fade-in">
      <h1>{product.data.title_en}</h1>
      <p class="lead">{product.data.description_en}</p>
    </div>
  </div>
  
  <main class="page-container">
    <div class="container">
      <div class="product-layout">
        <div class="product-visuals">
          {product.data.gallery && product.data.gallery.length > 0 ? (
            <ProductGallery 
              images={product.data.gallery.map(img => ({
                src: img.src,
                alt: img.alt_en
              }))} 
            />
          ) : (
            <img src={product.data.hero_image.replace('-hero', '-detail')} alt={product.data.title_en} class="main-image" />
          )}
        </div>
        
        <div class="product-details">
          <h2>Key Features</h2>
          {product.data.features_en && product.data.features_en.length > 0 && (
            <ul class="features-list">
              {product.data.features_en.map(feature => (
                <li>{feature}</li>
              ))}
            </ul>
          )}
          
          <div class="description-text">
            {enContent.split('\n\n').filter(p => p.trim()).map(paragraph => (
              <p>{paragraph}</p>
            ))}
          </div>
          
          <div class="cta-box">
            <h3>Interested in this product?</h3>
            <p>Contact us for a custom quote or technical advice.</p>
            <a href="/en/contact" class="btn">Request Quote</a>
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <Footer lang={lang} />
</BaseLayout>

<style>
  .product-hero {
    padding: var(--spacing-xl) 0;
    color: var(--color-white);
    background-size: cover;
    background-position: center;
    text-align: center;
  }
  
  .product-hero h1 {
    font-size: 3.5rem;
    margin-bottom: var(--spacing-sm);
  }
  
  .lead {
    font-size: 1.25rem;
    max-width: 800px;
    margin: 0 auto;
    color: var(--color-gray-200);
  }
  
  .page-container {
    padding: var(--spacing-xl) 0;
  }
  
  .product-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
  }
  
  .main-image {
    width: 100%;
    border-radius: var(--border-radius);
  }
  
  .features-list {
    list-style: none;
    margin-bottom: var(--spacing-md);
  }
  
  .features-list li {
    padding-left: 1.5rem;
    position: relative;
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }
  
  .features-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: bold;
  }
  
  .description-text p {
    margin-bottom: 1rem;
    line-height: 1.7;
    color: var(--color-gray-800);
  }
  
  .cta-box {
    background-color: var(--color-gray-100);
    padding: var(--spacing-md);
    border-radius: var(--border-radius);
    margin-top: var(--spacing-lg);
    border-left: 4px solid var(--color-primary);
  }
  
  .cta-box h3 {
    margin-bottom: 0.5rem;
  }
  
  .cta-box p {
    margin-bottom: 1rem;
  }
  
  @media (max-width: 992px) {
    .product-layout {
      grid-template-columns: 1fr;
    }
    
    .product-hero h1 {
      font-size: 2.5rem;
    }
  }
</style>
