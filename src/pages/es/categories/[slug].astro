---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  return categories.map(cat => ({
    params: { slug: cat.id },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const lang = 'es';
const prefix = '/es';
const subs = category.data.subcategories || [];
---

<BaseLayout title={category.data.title_es} lang={lang}>
  <Header lang={lang} />

  <div class="category-hero">
    <div class="category-hero-bg" style={`background-image: url('${category.data.thumbnail}')`}></div>
    <div class="category-hero-overlay"></div>
    <div class="container category-hero-content animate-fade-in">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/es/">Inicio</a> <span>/</span>
        <a href="/es/categories">Categorías</a> <span>/</span>
        <span class="current">{category.data.title_es}</span>
      </nav>
      <h1>{category.data.title_es}</h1>
      <p>{category.data.description_es}</p>
    </div>
  </div>

  <main class="page-container">
    <div class="container">
      {subs.length > 0 ? (
        <div class="subcategory-grid">
          {subs.map(sub => (
            <a href={`${prefix}/categories/${category.id}/${sub.slug}`} class="subcategory-card" id={`sub-${sub.slug}`}>
              <div class="sub-image-wrap">
                <img src={sub.images[0]?.src} alt={sub.title_es} loading="lazy" />
              </div>
              <div class="sub-content">
                <h3>{sub.title_es}</h3>
                {sub.description_es && <p>{sub.description_es}</p>}
                <span class="sub-link">Ver Detalles →</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="no-sub">No hay subcategorías disponibles.</p>
      )}

      <div class="contact-banner">
        <div class="contact-banner-content">
          <h3>¿Necesitas más información?</h3>
          <p>Nuestro equipo está listo para asistirte con especificaciones de producto, soluciones personalizadas y precios.</p>
        </div>
        <a href="/es/contact" class="btn" id="category-contact-cta">Contáctanos</a>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .category-hero {
    position: relative;
    padding: var(--spacing-xl) 0 var(--spacing-lg);
    overflow: hidden;
  }

  .category-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    z-index: 0;
  }

  .category-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(13,13,13,0.9) 0%, rgba(13,13,13,0.7) 100%);
    z-index: 1;
  }

  .category-hero-content {
    position: relative;
    z-index: 2;
    color: var(--color-white);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--spacing-sm);
    font-size: 0.9rem;
  }

  .breadcrumb a { color: var(--color-gray-300); transition: color 0.2s; }
  .breadcrumb a:hover { color: var(--color-white); }
  .breadcrumb span { color: var(--color-gray-600); }
  .breadcrumb .current { color: var(--color-primary); font-weight: 500; }

  .category-hero-content h1 { color: var(--color-white); margin-bottom: var(--spacing-xs); }
  .category-hero-content p { color: var(--color-gray-300); font-size: 1.1rem; max-width: 700px; line-height: 1.6; }

  .page-container { padding: var(--spacing-xl) 0; }

  .subcategory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: var(--spacing-md);
  }

  .subcategory-card {
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border-radius: var(--border-radius);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    transition: transform 0.4s var(--transition-smooth), box-shadow 0.4s var(--transition-smooth);
    color: var(--color-black);
    text-decoration: none;
  }

  .subcategory-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(0,0,0,0.1);
  }

  .sub-image-wrap {
    aspect-ratio: 16/10;
    overflow: hidden;
    background: var(--color-gray-100);
  }

  .sub-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--transition-smooth);
  }

  .subcategory-card:hover .sub-image-wrap img {
    transform: scale(1.05);
  }

  .sub-content { padding: 1.5rem; display: flex; flex-direction: column; flex-grow: 1; }
  .sub-content h3 { font-size: 1.2rem; margin-bottom: 0.4rem; }
  .sub-content p { font-size: 0.92rem; color: var(--color-gray-600); line-height: 1.5; margin-bottom: 1rem; }
  .sub-link { font-weight: 600; color: var(--color-primary); font-size: 0.9rem; margin-top: auto; }

  .contact-banner {
    margin-top: var(--spacing-xl);
    padding: var(--spacing-md);
    background: var(--color-gray-100);
    border-radius: var(--border-radius);
    border-left: 4px solid var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
  }

  .contact-banner h3 { margin-bottom: 0.25rem; font-size: 1.15rem; }
  .contact-banner p { color: var(--color-gray-600); margin: 0; font-size: 0.95rem; }

  .no-sub { text-align: center; color: var(--color-gray-600); font-size: 1.1rem; padding: var(--spacing-lg); }

  @media (max-width: 768px) {
    .subcategory-grid { grid-template-columns: 1fr; }
    .contact-banner { flex-direction: column; text-align: center; }
  }
</style>
