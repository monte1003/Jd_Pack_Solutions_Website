---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const lang = 'es';
---

<BaseLayout title="Quiénes Somos" lang={lang}>
  <Header lang={lang} />

  <div class="page-hero">
    <div class="container animate-fade-in">
      <h1>Quiénes Somos</h1>
      <p>Más de 15 años entregando soluciones premium de empaque.</p>
    </div>
  </div>

  <main class="page-container">
    <div class="container">
      <div class="about-grid">
        <div class="about-content animate-fade-in">
          <p class="lead"><strong>JD Pack Solutions</strong>, establecida hace más de 15 años, ofrece soluciones de empaque innovadoras y de alta calidad adaptadas a las industrias láctea, cárnica, alimentaria y de bebidas.</p>

          <p>Nuestro extenso portafolio de productos incluye empaques impresos y no impresos, como pouches, bolsas, películas especiales y soluciones de termoformado rígidas y flexibles. Diseñados para rendimiento y confiabilidad, nuestros empaques protegen sus productos, mejoran su presencia en estante y ayudan a que su marca destaque en el mercado.</p>

          <div class="mission-vision">
            <div class="card">
              <h3>Nuestra Misión</h3>
              <p>Proporcionar soluciones de empaque innovadoras y de alta calidad que agreguen valor a los productos de nuestros clientes, garantizando su integridad desde la producción hasta el consumidor final.</p>
            </div>

            <div class="card">
              <h3>Nuestra Visión</h3>
              <p>Ser reconocidos como el socio logístico y de empaque líder en el mercado, destacando por nuestra adaptabilidad, tecnología y compromiso con la excelencia.</p>
            </div>
          </div>

          <h3>¿Por qué elegirnos?</h3>
          <ul class="features-list">
            <li>Atención personalizada y asesoría técnica.</li>
            <li>Materiales de primera calidad probados bajo estándares internacionales.</li>
            <li>Amplia cobertura y soluciones logísticas eficientes.</li>
            <li>Compromiso con la innovación y sostenibilidad.</li>
          </ul>

          <div class="cta-section">
            <a href="/es/contact" class="btn" id="about-contact-cta">Contáctanos</a>
          </div>
        </div>

        <div class="about-image-col">
          <div class="about-image" style="background-image: url('/images/categories/thermoforming-films/high-barrier-flexible.jpeg');"></div>
        </div>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .page-hero {
    background-color: var(--color-black);
    color: var(--color-white);
    padding: var(--spacing-xl) 0 var(--spacing-lg);
    text-align: center;
  }

  .page-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--spacing-xs);
  }

  .page-hero h1::after {
    content: '';
    display: block;
    width: 50px;
    height: 3px;
    background-color: var(--color-primary);
    margin: 0.75rem auto 0;
  }

  .page-hero p {
    color: var(--color-gray-300);
    font-size: 1.15rem;
  }

  .page-container {
    padding: var(--spacing-xl) 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--spacing-xl);
    align-items: start;
  }

  .lead {
    font-size: 1.2rem;
    color: var(--color-primary);
    font-weight: 500;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .about-content p {
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
    color: var(--color-gray-800);
    line-height: 1.7;
  }

  .mission-vision {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-sm);
    margin: var(--spacing-md) 0;
  }

  .card {
    background: var(--color-gray-100);
    padding: 1.5rem;
    border-radius: var(--border-radius);
    border-top: 4px solid var(--color-primary);
  }

  .card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .card p {
    font-size: 0.95rem !important;
    margin-bottom: 0 !important;
  }

  .features-list {
    list-style: none;
    margin-top: 1rem;
    margin-bottom: var(--spacing-md);
  }

  .features-list li {
    font-size: 1.05rem;
    margin-bottom: 0.75rem;
    color: var(--color-gray-800);
    padding-left: 1.5rem;
    position: relative;
  }

  .features-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: bold;
  }

  .about-image-col {
    position: sticky;
    top: 100px;
  }

  .about-image {
    width: 100%;
    aspect-ratio: 3/4;
    background-size: cover;
    background-position: center;
    border-radius: var(--border-radius-lg);
    box-shadow: 0 20px 60px rgba(0,0,0,0.1);
  }

  .cta-section {
    margin-top: var(--spacing-sm);
  }

  @media (max-width: 992px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-image-col {
      position: static;
      order: -1;
      margin-bottom: var(--spacing-md);
    }

    .about-image {
      aspect-ratio: 16/9;
    }

    .mission-vision {
      grid-template-columns: 1fr;
    }
  }
</style>
