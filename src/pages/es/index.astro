---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import { getCollection } from 'astro:content';

const lang = 'es';
const allCategories = await getCollection('categories');
const visibleCategories = allCategories.filter(c => c.data.visible).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Inicio" lang={lang} description="JD Pack Solutions - Soluciones premium de empaque para las industrias láctea, cárnica, alimentaria y de bebidas. Más de 15 años de innovación.">
  <Header lang={lang} />

  <Hero
    title="Soluciones de Empaque y Logística"
    subtitle="Profesionalismo, calidad y adaptabilidad para tus necesidades de embalaje."
    ctaText="Contáctanos"
    ctaLink="/es/contact"
    secondaryCtaText="Ver Catálogo"
    secondaryCtaLink="/es/categories"
    backgroundImage="/images/hero-background.png"
  />

  <!-- Categories Section -->
  <section class="section" id="categories-section">
    <div class="container">
      <div class="section-header text-center">
        <h2>Categorías</h2>
        <p>Explora nuestras soluciones especializadas de empaque para diversas industrias.</p>
      </div>

      <div class="category-grid">
        {visibleCategories.map(cat => (
          <CategoryCard
            title={cat.data.title_es}
            image={cat.data.thumbnail}
            slug={cat.id}
            lang={lang}
            description={cat.data.description_es}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- About Preview Section -->
  <section class="section section-dark" id="about-preview">
    <div class="container">
      <div class="about-grid">
        <div class="about-text animate-fade-in">
          <h2>Sobre JD Pack Solutions</h2>
          <div class="about-accent-line"></div>
          <p>JD Pack Solutions, establecida hace más de 15 años, ofrece soluciones de empaque innovadoras y de alta calidad adaptadas a las industrias láctea, cárnica, alimentaria y de bebidas. Nuestro extenso portafolio de productos incluye empaques impresos y no impresos, como pouches, bolsas, películas especiales y soluciones de termoformado rígidas y flexibles. Diseñados para rendimiento y confiabilidad, nuestros empaques protegen sus productos, mejoran su presencia en estante y ayudan a que su marca destaque en el mercado.</p>
          <a href="/es/about" class="btn" style="margin-top: var(--spacing-sm);" id="about-cta">Conócenos</a>
        </div>
        <div class="about-image-wrap">
          <div class="about-image" style="background-image: url('/images/categories/custom-printed-pouches/custom-printed-pouches.jpeg');"></div>
        </div>
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--spacing-md);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
    align-items: center;
  }

  .about-text h2 {
    color: var(--color-white);
  }

  .about-accent-line {
    width: 50px;
    height: 3px;
    background-color: var(--color-primary);
    margin-bottom: 1.25rem;
    border-radius: 2px;
  }

  .about-text p {
    color: var(--color-gray-300);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 0.5rem;
  }

  .about-image-wrap {
    display: flex;
    justify-content: center;
  }

  .about-image {
    width: 100%;
    max-width: 480px;
    aspect-ratio: 4/3;
    background-size: cover;
    background-position: center;
    border-radius: var(--border-radius-lg);
    box-shadow: 0 20px 60px rgba(0,0,0,0.4);
  }

  @media (max-width: 992px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }

    .about-image-wrap {
      order: -1;
    }

    .about-text {
      text-align: center;
    }

    .about-accent-line {
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 576px) {
    .category-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
