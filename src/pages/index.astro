---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import CategoryCard from '../components/CategoryCard.astro';
import { getCollection } from 'astro:content';

const lang = 'en';
const allCategories = await getCollection('categories');
const visibleCategories = allCategories.filter(c => c.data.visible).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Home" lang={lang} description="JD Pack Solutions - Premium packaging solutions for the dairy, protein, food, and beverage industries. Over 15 years of innovation.">
  <Header lang={lang} />

  <Hero
    title="Consulting and Commercialization of Packaging Material for the Food Industry"
    subtitle="Professionalism, quality and adaptability for your packaging needs."
    ctaText="Contact Us"
    ctaLink="/contact"
    secondaryCtaText="View Catalog"
    secondaryCtaLink="/categories"
    backgroundImage="/images/hero-background.png"
  />

  <!-- Categories Section -->
  <section class="section" id="categories-section">
    <div class="container">
      <div class="section-header text-center">
        <h2>Categories</h2>
        <p>Explore our specialized packaging solutions for various industries.</p>
      </div>

      <div class="category-grid">
        {visibleCategories.map(cat => (
          <CategoryCard
            title={cat.data.title_en}
            image={cat.data.thumbnail}
            slug={cat.id}
            lang={lang}
            description={cat.data.description_en}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- About Preview Section -->
  <section class="section section-dark" id="about-preview">
    <div class="container">
      <div class="about-grid">
        <div class="about-text animate-fade-in">
          <h2>About JD Pack Solutions</h2>
          <div class="about-accent-line"></div>
          <p>JD Pack Solutions, established over 15 years ago, offers innovative, high-quality packaging solutions tailored to the dairy, protein, food, and beverage industries. Our extensive product portfolio includes printed and non-printed packaging, such as pouches, bags, specialty films, and rigid and flexible thermoforming solutions. Engineered for performance and reliability, our packaging protects your products, enhances shelf appeal, and helps your brand stand out in the marketplace.</p>
          <a href="/about" class="btn" style="margin-top: var(--spacing-sm);" id="about-cta">Learn More</a>
        </div>
        <div class="about-image-wrap">
          <div class="about-image" style="background-image: url('/images/categories/custom-printed-pouches/custom-printed-pouches.jpeg');"></div>
        </div>
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--spacing-md);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
    align-items: center;
  }

  .about-text h2 {
    color: var(--color-white);
  }

  .about-accent-line {
    width: 50px;
    height: 3px;
    background-color: var(--color-primary);
    margin-bottom: 1.25rem;
    border-radius: 2px;
  }

  .about-text p {
    color: var(--color-gray-300);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 0.5rem;
  }

  .about-image-wrap {
    display: flex;
    justify-content: center;
  }

  .about-image {
    width: 100%;
    max-width: 480px;
    aspect-ratio: 4/3;
    background-size: cover;
    background-position: center;
    border-radius: var(--border-radius-lg);
    box-shadow: 0 20px 60px rgba(0,0,0,0.4);
  }

  @media (max-width: 992px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }

    .about-image-wrap {
      order: -1;
    }

    .about-text {
      text-align: center;
    }

    .about-accent-line {
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 576px) {
    .category-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
