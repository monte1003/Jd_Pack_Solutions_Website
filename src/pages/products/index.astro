---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCollection } from 'astro:content';

const lang = 'es';
const allProducts = await getCollection('products');
const visibleProducts = allProducts.filter(p => p.data.visible).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Catálogo de Productos" lang={lang}>
  <Header lang={lang} />
  
  <div class="page-header">
    <div class="container animate-fade-in">
      <h1>Nuestros Productos</h1>
      <p>Soluciones especializadas en empaque, embalaje y logística.</p>
    </div>
  </div>
  
  <main class="page-container">
    <div class="container">
      <div class="product-grid">
        {visibleProducts.map(product => (
          <ProductCard 
            title={product.data.title_es}
            image={product.data.hero_image.replace('-hero', '-thumbnail')}
            slug={product.id}
            lang={lang}
          />
        ))}
      </div>
    </div>
  </main>
  
  <Footer lang={lang} />
</BaseLayout>

<style>
  .page-header {
    background-color: var(--color-black);
    color: var(--color-white);
    padding: var(--spacing-xl) 0;
    text-align: center;
  }
  
  .page-header h1 {
    font-size: 3rem;
    margin-bottom: var(--spacing-sm);
  }
  
  .page-header p {
    font-size: 1.25rem;
    color: var(--color-gray-200);
  }
  
  .page-container {
    padding: var(--spacing-xl) 0;
  }
  
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--spacing-lg);
  }
</style>
