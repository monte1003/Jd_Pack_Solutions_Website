---
const { lang = 'es' } = Astro.props;

const translations = {
  es: {
    about: 'Quiénes Somos',
    products: 'Productos',
    contact: 'Contacto',
    rights: 'Todos los derechos reservados.',
    location: 'Miami, Florida'
  },
  en: {
    about: 'About Us',
    products: 'Products',
    contact: 'Contact',
    rights: 'All rights reserved.',
    location: 'Miami, Florida'
  }
};

const t = translations[lang];
const prefix = lang === 'es' ? '' : `/${lang}`;
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-container">
    <div class="footer-col">
      <img src="/images/logo.svg" alt="JD Pack Solutions Logo" class="footer-logo" />
      <p class="company-desc">
        Premium Packaging, Wrapping & Custom Logistics Solutions.
      </p>
    </div>
    
    <div class="footer-col">
      <h3>Links</h3>
      <ul class="footer-links">
        <li><a href={`${prefix}/`}>Inicio</a></li>
        <li><a href={`${prefix}/about`}>{t.about}</a></li>
        <li><a href={`${prefix}/products`}>{t.products}</a></li>
        <li><a href={`${prefix}/contact`}>{t.contact}</a></li>
      </ul>
    </div>
    
    <div class="footer-col">
      <h3>{t.contact}</h3>
      <address class="contact-info">
        <p>📍 {t.location}</p>
        <p>📧 <a href="mailto:example@gmail.com">example@gmail.com</a></p>
      </address>
    </div>
  </div>
  
  <div class="footer-bottom">
    <div class="container">
      <p>&copy; {currentYear} JD Pack Solutions. {t.rights}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-black);
    color: var(--color-white);
    padding-top: var(--spacing-lg);
  }
  
  .footer-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
  }
  
  .footer-logo {
    height: 40px;
    margin-bottom: var(--spacing-sm);
    /* Invert colors or adjust if logo is dark, but ours is white and red */
  }
  
  .company-desc {
    color: var(--color-gray-200);
  }
  
  .footer-col h3 {
    color: var(--color-white);
    margin-bottom: var(--spacing-sm);
  }
  
  .footer-links {
    list-style: none;
  }
  
  .footer-links li {
    margin-bottom: 0.5rem;
  }
  
  .footer-links a, .contact-info a {
    color: var(--color-gray-200);
  }
  
  .footer-links a:hover, .contact-info a:hover {
    color: var(--color-primary);
  }
  
  .contact-info {
    font-style: normal;
  }
  
  .contact-info p {
    margin-bottom: 0.5rem;
  }
  
  .footer-bottom {
    background-color: #1a1718;
    padding: var(--spacing-sm) 0;
    text-align: center;
    color: var(--color-gray-200);
    font-size: 0.9rem;
  }
</style>
